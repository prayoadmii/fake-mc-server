[Unit]
Description=The server that hosts a fake Minecraft server for status fetching
After=network.target

[Service]
Type=simple
User=mcstatus
Group=users
WorkingDirectory=/opt/mcstatus/demo-server/
ExecStart=/opt/mcstatus/demo-server/bin/main
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target